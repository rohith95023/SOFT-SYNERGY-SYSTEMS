# Environment Variables for Soft Synergy Systems Website
# Rename this file to .env and fill in real values

# ── Contact Form (EmailJS) ─────────────────────────────────────────
# Sign up at https://www.emailjs.com and create a service + template
VITE_EMAILJS_SERVICE_ID=service_xxxxxxx
VITE_EMAILJS_TEMPLATE_ID=template_xxxxxxx
VITE_EMAILJS_PUBLIC_KEY=your_public_key

# ── Google Maps ────────────────────────────────────────────────────
# Get API key from https://console.cloud.google.com
VITE_GOOGLE_MAP_KEY=AIzaXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX

# ── Analytics ─────────────────────────────────────────────────────
# Google Analytics 4 Measurement ID
VITE_GA_MEASUREMENT_ID=G-XXXXXXXXXX

# ── Company Info (optional override) ──────────────────────────────
VITE_CONTACT_EMAIL=hr@softsynergysystems.com
VITE_CONTACT_PHONE=+918296453365
