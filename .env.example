# ====================================================
# Soft Synergy Systems — Environment Variables Template
# ====================================================
# Copy this file to .env and fill in your actual values.
# NEVER commit .env to version control.
# This file (.env.example) MUST always be committed.
# ====================================================

# ── Application ────────────────────────────────────────
VITE_BASE_URL=https://softsynergysystems.com

# ── Contact Info ───────────────────────────────────────
VITE_CONTACT_EMAIL=hr@softsynergysystems.com
VITE_CONTACT_PHONE=+91 97908 23800

# ── EmailJS (Contact Form Delivery) ───────────────────
# Sign up at https://www.emailjs.com and create a service + template.
VITE_EMAILJS_SERVICE_ID=service_xxxxxxx
VITE_EMAILJS_TEMPLATE_ID=template_xxxxxxx
VITE_EMAILJS_PUBLIC_KEY=xxxxxxxxxxxxxxxxxxxx

# ── Google Analytics 4 ────────────────────────────────
# Get from https://analytics.google.com → Admin → Data Streams
VITE_GA_MEASUREMENT_ID=G-XXXXXXXXXX

# ── Google Maps ───────────────────────────────────────
# Get from https://console.cloud.google.com → Maps JavaScript API
VITE_GOOGLE_MAP_KEY=AIzaXXXXXXXXXXXXXXXXXXXXXXXXXXXXX

# ── PostHog Analytics (Optional) ─────────────────────
VITE_POSTHOG_KEY=phc_XXXXXXXXXXXXXXXXXXXX

# ── Feature Flags ─────────────────────────────────────
# Set to 'true' to enable experimental features
VITE_FEATURE_LIVE_CHAT=false
VITE_FEATURE_BETA_CHECKOUT=false
